# Copy this file to .env and fill in a device token to enable Foxglove Remote Access.
# Create a device + token on the Devices page: https://app.foxglove.dev/~/devices
# Leave FOXGLOVE_DEVICE_TOKEN unset (or this file absent) to skip remote access and
# connect locally at ws://localhost:8765 instead -- see the README's "Remote access" section.
FOXGLOVE_DEVICE_TOKEN=

<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="foxglove_demo">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required system plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!--
      Sensors must be explicitly loaded for camera/depth sensors to render and publish.
      ogre2 is required for headless rendering (works with software/Mesa rendering
      inside Docker, see the README for the required LIBGL_ALWAYS_SOFTWARE=1 env var).
    -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.4 0.42 0.45 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Factory-scale fill lights: the workcell building below is roughly 20x20m with
         a ~7m ceiling, much bigger than this tutorial's original small room, so these
         sit higher up and fall off over a much longer range than a room light would. -->
    <light type="point" name="factory_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>0 -3 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>
    <light type="point" name="factory_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>0 3 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!--
      "Workcell": a warehouse building shell (walls, roof-support poles, storage
      racks, pallets, a conveyor line, a control panel), reused from
      github.com/wh200720041/warehouse_simulation_toolkit (models/workcell), BSD-3
      licensed; see models/workcell/LICENSE. Built for Gazebo Classic originally, but
      it's just static mesh geometry plus box collisions, no plugins, so it loads in
      Gazebo Sim/Harmonic unchanged via GZ_SIM_RESOURCE_PATH (see
      simulation.launch.py). The toolkit's AGV robot, actors, and workcell_bin prop
      model weren't pulled in: this tutorial's arm replaces the AGV, and the actors
      use a Gazebo-Classic-only collision plugin that doesn't exist in Gazebo Sim.
    -->
    <include>
      <uri>model://workcell</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!--
      Table the arm, foxglove_box, and static_camera all sit on, instead of directly on
      the workcell floor. See the table_height offset applied to those in
      simulation.launch.py and arm_z in robot.xacro. Top surface is at z=0.5 to match
      those; keep the three in sync.
    -->
    <model name="arm_table_top">
      <static>true</static>
      <pose>1.0 -3.5 0.475 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.05</size></box></geometry>
          <material>
            <ambient>0.78 0.72 0.62 1</ambient>
            <diffuse>0.78 0.72 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arm_table_leg_1">
      <static>true</static>
      <pose>1.42 -3.18 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arm_table_leg_2">
      <static>true</static>
      <pose>1.42 -3.82 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arm_table_leg_3">
      <static>true</static>
      <pose>0.58 -3.18 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arm_table_leg_4">
      <static>true</static>
      <pose>0.58 -3.82 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.45</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

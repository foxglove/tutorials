{
  "name": "model-ghost-preview",
  "displayName": "Model Ghost Preview",
  "description": "Preview a topic's 3D model as a ghost at the hovered timeline time, even while playback is paused.",
  "publisher": "Foxglove",
  "homepage": "https://github.com/foxglove/tutorials",
  "version": "0.1.0",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove",
    "3d",
    "preview",
    "timeline"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "test": "vitest run",
    "dev:harness": "vite --config dev/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "3.3.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.170.0",
    "create-foxglove-extension": "1.3.2",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "puppeteer-core": "24.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
